{
  "manifest_version": 3,
  "name": "Tab Matrix · 标签矩阵",
  "version": "1.2.1",
  "description": "在新标签页搜索和管理所有窗口的标签，清理重复页面，查看久未访问的标签。",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "打开标签矩阵"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "121"
}
