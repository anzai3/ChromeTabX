{
  "manifest_version": 3,
  "name": "ChromeTabX — Tab Manager",
  "version": "1.6.5",
  "description": "Find open tabs fast. Search across windows, browse by topic, preview pages, and close duplicate tabs from your new-tab page.",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "debugger"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Open ChromeTabX",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
