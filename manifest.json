{
  "manifest_version": 3,
  "name": "Tab Matrix · 标签矩阵",
  "version": "1.4.6",
  "description": "集中管理大量标签，快速搜索页面、按主题分类并清理重复网址，减少翻找和不必要的页面。",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "打开标签矩阵"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "121"
}
