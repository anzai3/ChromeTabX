{
  "manifest_version": 3,
  "name": "Tab Matrix · 标签矩阵",
  "version": "1.6.4",
  "description": "集中管理大量标签，快速搜索页面、按主题分类并清理重复网址，减少翻找和不必要的页面。",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "debugger"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "打开标签矩阵",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
